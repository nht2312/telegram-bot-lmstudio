# Rename this file to .env and update the values before running the bot.

# Telegram bot token from BotFather
BOT_TOKEN=your-telegram-bot-token-here

# LLM backend: lmstudio (default) or ollama (OpenAI-compatible API at /v1)
# For Ollama: set LLM_PROVIDER=ollama, run `ollama serve`, and use /set_model with an Ollama model name (e.g. llama3.2).
LLM_PROVIDER=lmstudio

LMSTUDIO_BASE_URL=http://localhost:1234/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
# Max completion tokens per Ollama request (default 16384). LM Studio is unchanged.
OLLAMA_MAX_TOKENS=16384

# When LLM_PROVIDER=lmstudio — optional per-endpoint overrides (default: LMSTUDIO_BASE_URL + path).
LM_STUDIO_MODELS_URL=${LMSTUDIO_BASE_URL}/models
LM_STUDIO_CHAT_COMPLETIONS_URL=${LMSTUDIO_BASE_URL}/chat/completions
LM_STUDIO_COMPLETIONS_URL=${LMSTUDIO_BASE_URL}/completions
LM_STUDIO_EMBEDDINGS_URL=${LMSTUDIO_BASE_URL}/embeddings

# When LLM_PROVIDER=ollama — LM_STUDIO_*_URL above are ignored. Defaults use OLLAMA_BASE_URL.
# Optional overrides: OLLAMA_MODELS_URL, OLLAMA_CHAT_COMPLETIONS_URL, OLLAMA_COMPLETIONS_URL, OLLAMA_EMBEDDINGS_URL
# Tailscale/VPN: use the peer IP as host; 404 from Ollama usually means wrong/missing model name — run `ollama list` on the server.

DEFAULT_MODEL=qwen3.5-2b
TOKEN_THRESHOLD=7975

LOADING_MESSAGE_ENABLED=true
LOADING_SUMMARIZE_ENABLED=true
LOADING_UPDATE_INTERVAL=5
LOADING_TIMEOUT=300

STREAMING_ENABLED=true
STREAM_UPDATE_INTERVAL=3.0
STREAM_MIN_CHARS=20
STREAM_CANCEL_TIMEOUT=300
# Seconds between SSE chunks when streaming (remote Ollama / long TTFT); raise if stream dies early
STREAM_READ_TIMEOUT=300
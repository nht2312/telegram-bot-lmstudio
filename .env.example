# Rename this file to .env and update the values before running the bot.

# Telegram bot token from BotFather
BOT_TOKEN=your-telegram-bot-token-here

LMSTUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODELS_URL=${LMSTUDIO_BASE_URL}/models
LM_STUDIO_CHAT_COMPLETIONS_URL=${LMSTUDIO_BASE_URL}/chat/completions
LM_STUDIO_COMPLETIONS_URL=${LMSTUDIO_BASE_URL}/completions
LM_STUDIO_EMBEDDINGS_URL=${LMSTUDIO_BASE_URL}/embeddings

DEFAULT_MODEL=qwen3.5-2b
TOKEN_THRESHOLD=7975

LOADING_MESSAGE_ENABLED=true
LOADING_SUMMARIZE_ENABLED=true
LOADING_UPDATE_INTERVAL=5
LOADING_TIMEOUT=300

STREAMING_ENABLED=true
STREAM_UPDATE_INTERVAL=1.0
STREAM_CANCEL_TIMEOUT=300